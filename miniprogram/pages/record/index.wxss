.record-page { background: linear-gradient(180deg,#f6faf7 0%,#fff 70%); }
.record-page .page-header{padding:0 10rpx 0 4rpx}
.intro { margin-top: 72rpx; text-align: center; }
.intro image { width: 76rpx; height: 76rpx; border-radius: 22rpx; box-shadow: 0 12rpx 28rpx rgba(46,157,98,.16); }
.brand { display: block; margin-top: 12rpx; color: #2e9d62; font-size: 22rpx; font-weight: 800; letter-spacing: 4rpx; }
.record-title { margin: 44rpx 0 16rpx; font-size: 46rpx; line-height: 1.25; font-weight: 800; }
.record-subtitle { display:block; color: #869089; font-size: 27rpx; }
.voice-zone { position: relative; width: 360rpx; height: 360rpx; margin: 68rpx auto 0; display: grid; place-items: center; }
.voice-ring { position: absolute; border-radius: 50%; border: 2rpx solid rgba(46,157,98,.11); }
.voice-ring--one { inset: 18rpx; background: rgba(225,244,233,.4); }.voice-ring--two { inset: 62rpx; background: rgba(219,241,228,.65); }
.voice-button { position: relative; z-index: 2; width: 188rpx; height: 188rpx; border-radius: 50%; background: linear-gradient(145deg,#43b879,#258c58); box-shadow: 0 26rpx 52rpx rgba(46,157,98,.3), inset 0 2rpx 4rpx rgba(255,255,255,.4); }
.mic { position: absolute; left: 67rpx; top: 44rpx; width: 54rpx; height: 74rpx; border: 7rpx solid #fff; border-radius: 30rpx; }
.mic:after { content:''; position:absolute; left:50%; bottom:-32rpx; width:7rpx; height:28rpx; background:#fff; transform:translateX(-50%); border-radius:4rpx; }
.mic:before { content:''; position:absolute; left:50%; bottom:-18rpx; width:82rpx; height:44rpx; border:7rpx solid #fff; border-top:0; border-radius:0 0 46rpx 46rpx; transform:translateX(-50%); }
.voice-zone.is-recording .voice-ring { animation: pulse 1.3s ease-in-out infinite alternate; }.voice-zone.is-recording .voice-button { background:linear-gradient(145deg,#ef846f,#cf5548); }
@keyframes pulse { from { transform:scale(.94); opacity:.45 } to { transform:scale(1.04); opacity:1 } }
.voice-copy { text-align:center; }.voice-title{display:block;font-size:30rpx;font-weight:800}.voice-copy>text:last-child{display:block;margin-top:9rpx;color:#a07970;font-size:23rpx}
.keyboard-link { margin: 42rpx auto 0; display:flex; align-items:center; justify-content:center; gap:10rpx; color:#748079; font-size:26rpx; text-decoration:underline; }
.keyboard-icon { font-size:31rpx; text-decoration:none; }.voice-hint{margin:28rpx auto 0;max-width:560rpx;padding:20rpx 24rpx;color:#5e6b63;background:#f0f6f2;border-radius:20rpx;font-size:23rpx;line-height:1.6;text-align:center}
.confirm-page { padding-top: 10rpx; }.back{width:70rpx;height:70rpx;color:#445149;background:#fff;border-radius:50%;font-size:58rpx;box-shadow:0 8rpx 22rpx rgba(30,50,39,.08)}
.confirm-title{margin:40rpx 0 22rpx;font-size:43rpx;font-weight:800}.transcript{padding:26rpx;color:#4f5d55;background:#edf4ef;border-radius:24rpx;line-height:1.7}
.summary{margin:26rpx 0;padding:8rpx 26rpx}.summary>view{display:grid;grid-template-columns:56rpx 90rpx 1fr;align-items:start;padding:25rpx 0;border-bottom:1rpx solid #edf0ee}.summary>view:last-child{border:0}.summary-icon{width:42rpx;height:42rpx;display:grid;place-items:center;color:#2e9d62;background:#e8f4ec;border-radius:12rpx;font-size:20rpx}.summary-label{color:#76827b}.summary-value{font-size:26rpx;line-height:1.55;font-weight:700}.summary-value.muted{color:#a8b0ab;font-weight:500}
.followup{margin-bottom:24rpx;padding:26rpx}.followup-title{display:block;font-weight:800}.followup-copy{display:block;margin:10rpx 0;color:#606b65;line-height:1.6}.followup>view{display:flex;gap:12rpx}.followup input{flex:1;height:70rpx;padding:0 20rpx;background:#f4f7f5;border-radius:16rpx}.followup button{width:110rpx;color:#fff;background:#2e9d62;border-radius:16rpx;font-weight:700}.confirm-page .secondary-button{margin-top:16rpx}
.saved-page{padding-top:90rpx;text-align:center}.saved-check{width:116rpx;height:116rpx;margin:0 auto;display:grid;place-items:center;color:#fff;background:#2e9d62;border-radius:50%;font-size:62rpx}.saved-title{margin:32rpx 0 12rpx;font-size:42rpx;font-weight:800}.saved-subtitle{display:block;color:#839087}.feedback-card{margin-top:24rpx;padding:28rpx;display:flex;gap:20rpx;text-align:left}.feedback-card>text{width:52rpx;height:52rpx;display:grid;place-items:center;color:#2e9d62;background:#e8f4ec;border-radius:16rpx}.feedback-title{margin:0 0 8rpx;font-size:28rpx;font-weight:800}.feedback-copy{display:block;color:#66736b;line-height:1.65}.saved-page .primary-button{margin-top:34rpx}
.sheet-mask{position:fixed;z-index:100;inset:0;display:flex;align-items:flex-end;background:rgba(14,27,20,.35)}.input-sheet{width:100%;max-height:88vh;overflow-y:auto;padding:18rpx 30rpx calc(42rpx + env(safe-area-inset-bottom));background:#fff;border-radius:34rpx 34rpx 0 0}.sheet-handle{width:70rpx;height:8rpx;margin:0 auto 24rpx;background:#d9dedb;border-radius:999rpx}.sheet-title{display:flex;align-items:center;justify-content:space-between}.sheet-heading{font-size:32rpx;font-weight:800}.sheet-title button{width:64rpx;height:64rpx;color:#657169;background:#f1f4f2;border-radius:50%;font-size:42rpx}.input-sheet textarea{width:100%;height:260rpx;margin:18rpx 0;padding:24rpx;background:#f5f8f6;border-radius:24rpx;line-height:1.65}.sheet-hint{display:block;margin:-4rpx 0 20rpx;color:#718078;font-size:23rpx;line-height:1.55}.sheet-action{position:sticky;bottom:0;padding-top:10rpx;background:#fff}.sheet-action .primary-button{min-height:88rpx}

