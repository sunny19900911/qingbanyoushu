.history-scroll{margin:0 -32rpx;padding:0 32rpx}.history-track{display:flex;gap:18rpx;padding-right:32rpx}.history-card{width:520rpx;flex:none;padding:27rpx}.history-card>text{color:#2e9d62;font-size:21rpx;font-weight:800}.history-card .h3{margin:13rpx 0 12rpx;font-size:28rpx}.history-card .p{margin:0;color:#5f6d64;line-height:1.65}.history-card>view{margin-top:20rpx;padding:16rpx;background:#f2f6f3;border-radius:16rpx}.history-card>view .strong{display:block;margin-bottom:6rpx;color:#708078;font-size:20rpx}.history-card>view text{color:#4d5b53;font-size:22rpx;line-height:1.5}
