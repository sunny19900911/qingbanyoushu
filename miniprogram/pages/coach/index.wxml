<view class="page-shell coach-page">
  <view class="page-header">
    <view class="h1 page-title">{{isCoach && coachMode === 'workspace' ? '教练工作台' : '训练与教练'}}</view>
    <button class="user-chip" bindtap="chooseUser"><text class="user-chip__avatar">{{userAlias === 'YC' ? 'Y' : '张'}}</text>{{userAlias}}⌄</button>
  </view>

  <view wx:if="{{isCoach}}" class="segmented role-switch">
    <button class="{{coachMode === 'workspace' ? 'is-active' : ''}}" data-mode="workspace" bindtap="switchCoachMode">教练工作台</button>
    <button class="{{coachMode === 'self' ? 'is-active' : ''}}" data-mode="self" bindtap="switchCoachMode">我的训练</button>
  </view>

  <view wx:if="{{loading}}" class="empty-state">正在整理训练与反馈…</view>

  <view wx:elif="{{isCoach && coachMode === 'workspace'}}" class="workspace">
    <view class="workspace-hero card">
      <view><text class="eyebrow">YC · 教练端</text><view class="h2">先看学员发生了什么，再回复一件最值得做的事。</view></view>
      <view class="workspace-stats">
        <view><text>{{dashboard.students.length}}</text><text>学员</text></view>
        <view><text>{{dashboard.questions.length}}</text><text>全部疑问</text></view>
        <view><text>{{selectedExerciseIds.length}}</text><text>已选动作</text></view>
      </view>
    </view>

    <view class="section-title"><view class="h2">学员动态</view><text>数据与沟通同页查看</text></view>
    <view wx:for="{{dashboard.students}}" wx:key="userId" class="student-card card">
      <view class="student-avatar">张</view>
      <view class="student-main"><view class="h3">{{item.displayAlias}}</view><text>最近记录 {{item.latestDate || '未记录'}}</text><text>最近体重 {{item.latestWeightKg || '未记录'}}{{item.latestWeightKg ? ' kg' : ''}}</text></view>
      <view class="student-status {{item.hasTrainingToday ? 'is-ready' : ''}}">{{item.hasTrainingToday ? '今日已布置' : '待布置训练'}}</view>
    </view>

    <view class="section-title"><view class="h2">学员疑问</view><text>{{dashboard.questions.length ? '按时间倒序' : '暂无新消息'}}</text></view>
    <view wx:if="{{!dashboard.questions.length}}" class="empty-card card"><view class="empty-icon">✓</view><text class="strong">目前没有待处理的疑问</text><text>学员发送语音或文字后，会出现在这里。</text></view>
    <view wx:for="{{dashboard.questions}}" wx:key="questionId" class="inbox-card card">
      <view class="inbox-meta"><text>{{item.displayAlias}}</text><text>{{item.status === 'replied' ? '已回复' : '待回复'}}</text></view>
      <text class="question-copy">{{item.questionText}}</text>
      <button wx:if="{{replyQuestionId !== item.questionId}}" data-id="{{item.questionId}}" bindtap="openReply">{{item.status === 'replied' ? '再补充一句' : '回复学员'}}</button>
      <view wx:else class="reply-compose"><textarea maxlength="300" value="{{replyText}}" bindinput="onReplyInput" placeholder="只回复最重要的一两点…"></textarea><view><button bindtap="closeReply">取消</button><button class="reply-send" bindtap="sendReply">发送</button></view></view>
    </view>

    <view class="section-title"><view class="h2">布置今日力量训练</view><text>示例学员</text></view>
    <view class="assign-card card">
      <text class="assign-hint">从熟悉或已确认的动作里选 1—3 个</text>
      <scroll-view scroll-x class="assign-scroll" enhanced show-scrollbar="false">
        <view class="assign-track">
          <button wx:for="{{exercises}}" wx:key="id" class="assign-exercise {{item.selected ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="toggleExerciseSelect">
            <image src="{{item.image}}" mode="aspectFit" /><text>{{item.name}}</text><text>{{item.bodyPart}} · {{item.level}}</text>
          </button>
        </view>
      </scroll-view>
      <view class="field"><text>组数与次数</text><input value="{{prescription}}" bindinput="onPrescriptionInput" /></view>
      <view class="field"><text>教练提醒</text><textarea maxlength="120" value="{{assignmentNote}}" bindinput="onAssignmentNoteInput"></textarea></view>
      <button class="primary-button" bindtap="saveAssignment">发送今日训练提醒</button>
    </view>
  </view>

  <view wx:else class="learner-view">
    <view class="training-card card {{training ? 'has-training' : ''}}">
      <view class="training-head"><view><text class="eyebrow">今日力量提醒</text><view class="h2">{{training ? '今天练得稳一点' : '今天还没有训练安排'}}</view></view><view class="training-mark">力</view></view>
      <view wx:if="{{training}}">
        <view class="training-prescription"><text>{{training.prescription}}</text><text>{{training.note}}</text></view>
        <view wx:for="{{training.exerciseItems}}" wx:key="id" class="today-exercise" data-id="{{item.id}}" bindtap="openExercise"><image src="{{item.image}}" mode="aspectFit" /><view><text class="strong">{{index + 1}}. {{item.name}}</text><text>{{item.muscle}} · {{item.equipment}}</text></view><text class="arrow">›</text></view>
      </view>
      <view wx:else class="no-training"><text>没有安排也不用补作业。</text><text>需要训练时，由教练从动作库里发一条简短提醒。</text></view>
    </view>

    <view class="section-title"><view class="h2">简短动作库</view><text>点开看动作提示</text></view>
    <scroll-view scroll-x class="category-scroll" enhanced show-scrollbar="false"><view class="category-track"><button wx:for="{{categories}}" wx:key="*this" class="{{activeCategory === item ? 'is-active' : ''}}" data-category="{{item}}" bindtap="filterCategory">{{item}}</button></view></scroll-view>
    <view class="exercise-grid">
      <button wx:for="{{filteredExercises}}" wx:key="id" class="exercise-card card" data-id="{{item.id}}" bindtap="openExercise"><image src="{{item.image}}" mode="aspectFit" /><view><text class="exercise-part">{{item.bodyPart}} · {{item.level}}</text><text class="strong">{{item.name}}</text><text>{{item.muscle}}</text></view></button>
    </view>
    <view class="safety-note">动作库用于看懂提醒；新动作、加重量或身体不适时，先和教练确认。</view>

    <view wx:if="{{!isCoach}}" class="question-card card">
      <view class="question-title"><view><text>训练或记录遇到问题</text><text class="strong">直接说给 YC</text></view><text class="pill">进入教练端</text></view>
      <view class="question-voice {{isRecording ? 'is-recording' : ''}}"><button bindtap="toggleVoice"><view class="mini-mic"></view></button><text class="strong">{{isRecording ? '再点一下结束' : '点一下开始说话'}}</text></view>
      <button class="question-keyboard" bindtap="toggleQuestion">⌨ {{questionOpen ? '收起键盘输入' : '不方便说？键盘输入'}}</button>
      <view wx:if="{{questionOpen}}" class="question-compose"><textarea maxlength="300" value="{{questionText}}" bindinput="onQuestionInput" placeholder="比如：今天肩膀不舒服，这个动作还要做吗？"></textarea><text wx:if="{{voiceHint}}">{{voiceHint}}</text><button bindtap="sendQuestion" disabled="{{questionText.length < 2}}">发送给 YC</button></view>
      <view wx:if="{{questionSent}}" class="sent">✓ 已发送到 YC 的教练工作台</view>
    </view>

    <view wx:if="{{!isCoach && replies.length}}">
      <view class="section-title"><view class="h2">YC 的回复</view><text>{{replies.length}} 条</text></view>
      <view wx:for="{{replies}}" wx:key="replyId" class="reply-card card"><view class="coach-avatar">YC</view><view><text class="strong">教练回复</text><text>{{item.replyText}}</text></view></view>
    </view>

    <view wx:if="{{history.length}}">
      <view class="section-title"><view class="h2">陪跑中的关键提醒</view><text>{{history.length}} 条</text></view>
      <scroll-view scroll-x class="history-scroll" enhanced show-scrollbar="false"><view class="history-track"><view wx:for="{{history}}" wx:key="feedbackId" class="history-card card"><text>{{item.linkedDate}}</text><view class="h3">{{item.stage}}</view><text class="p">{{item.coachMessage}}</text><view><text class="strong">当时的变化</text><text>{{item.observedChange}}</text></view></view></view></scroll-view>
    </view>
  </view>

  <view wx:if="{{detailExercise}}" class="detail-mask" bindtap="closeExercise">
    <view class="detail-sheet" catchtap="noop">
      <view class="sheet-handle"></view><image src="{{detailExercise.image}}" mode="aspectFit" />
      <view class="detail-body"><text class="exercise-part">{{detailExercise.bodyPart}} · {{detailExercise.level}} · {{detailExercise.equipment}}</text><view class="h2">{{detailExercise.name}}</view><text class="muscle-line">主要练：{{detailExercise.muscle}}</text><view class="step" wx:for="{{detailExercise.steps}}" wx:key="*this"><text>{{index + 1}}</text><text>{{item}}</text></view><view class="cue-box"><text class="strong">记住这一句</text><text>{{detailExercise.cue}}</text></view><view class="caution">{{detailExercise.caution}}</view><button class="secondary-button" bindtap="closeExercise">我知道了</button></view>
    </view>
  </view>
</view>
