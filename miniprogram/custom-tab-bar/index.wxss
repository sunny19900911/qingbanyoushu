.tab-shell { position: fixed; z-index: 90; left: 0; right: 0; bottom: 0; height: calc(112rpx + env(safe-area-inset-bottom)); padding: 12rpx 44rpx env(safe-area-inset-bottom); display: flex; align-items: flex-start; justify-content: space-around; background: rgba(255,255,255,.97); border-top: 1rpx solid #e7ece8; box-shadow: 0 -12rpx 36rpx rgba(33,58,44,.06); }
.tab-item { flex: 1; height: 88rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7rpx; color: #8d9690; font-size: 21rpx; font-weight: 700; }
.tab-item.is-active { color: #2e9d62; }
.tab-icon { position: relative; width: 42rpx; height: 38rpx; }
.record-glyph { position: absolute; inset: 3rpx 5rpx; border: 3rpx solid currentColor; border-radius: 6rpx; }
.record-glyph>view { position: absolute; left: 7rpx; right: 7rpx; height: 3rpx; background: currentColor; border-radius: 2rpx; }
.record-glyph>view:nth-child(1) { top: 7rpx; }.record-glyph>view:nth-child(2) { top: 14rpx; }.record-glyph>view:nth-child(3) { top: 21rpx; }
.trend-glyph { position: absolute; inset: 4rpx; display: flex; align-items: flex-end; gap: 4rpx; border-bottom: 3rpx solid currentColor; }
.trend-glyph>view { flex: 1; background: currentColor; border-radius: 4rpx 4rpx 0 0; }.trend-glyph>view:nth-child(1){height:11rpx}.trend-glyph>view:nth-child(2){height:24rpx}.trend-glyph>view:nth-child(3){height:17rpx}
.coach-glyph { position: absolute; inset: 4rpx 2rpx; border: 3rpx solid currentColor; border-radius: 9rpx; }
.coach-glyph:after { content: ''; position: absolute; left: 7rpx; bottom: -8rpx; width: 9rpx; height: 9rpx; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: skewY(-28deg); background: white; }
.coach-glyph>view { position: absolute; left: 8rpx; right: 8rpx; height: 3rpx; background: currentColor; border-radius: 2rpx; }.coach-glyph>view:first-child{top:8rpx}.coach-glyph>view:last-child{top:17rpx}

