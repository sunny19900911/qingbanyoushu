<view wx:if="{{!hidden}}" class="tab-shell">
  <button wx:for="{{list}}" wx:key="pagePath" class="tab-item {{selected === index ? 'is-active' : ''}}" data-index="{{index}}" bindtap="switchTab">
    <view class="tab-icon tab-icon--{{item.icon}}">
      <view wx:if="{{item.icon === 'record'}}" class="record-glyph"><view></view><view></view><view></view></view>
      <view wx:elif="{{item.icon === 'trend'}}" class="trend-glyph"><view></view><view></view><view></view></view>
      <view wx:else class="coach-glyph"><view></view><view></view></view>
    </view>
    <text>{{item.text}}</text>
  </button>
</view>

